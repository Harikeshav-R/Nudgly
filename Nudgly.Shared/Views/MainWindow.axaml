<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Nudgly.Shared.ViewModels"
        xmlns:conv="using:Nudgly.Shared.Converters"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:suki="clr-namespace:SukiUI.Controls;assembly=SukiUI"
        xmlns:material="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
        xmlns:mark="clr-namespace:LiveMarkdown.Avalonia;assembly=LiveMarkdown.Avalonia"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
        x:Class="Nudgly.Shared.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="Nudgly"
        Topmost="True"
        ShowInTaskbar="False"
        SystemDecorations="None"
        Background="Transparent"
        TransparencyLevelHint="Transparent"
        Width="700"
        Height="800"
        WindowStartupLocation="CenterScreen"
        Loaded="Window_OnLoaded">

    <Design.DataContext>
        <vm:MainWindowViewModel/>
    </Design.DataContext>

    <Window.Resources>
        <conv:LocalPathToBitmapConverter x:Key="LocalPathToBitmapConverter" />
    </Window.Resources>

    <!-- Main Container -->
    <Grid RowDefinitions="Auto,*" Margin="25">

        <!-- Toolbar / Input Area -->
        <Border Grid.Row="0" CornerRadius="20" Background="#CC151515" BorderBrush="#30FFFFFF" BorderThickness="1" BoxShadow="0 10 30 0 #60000000" Padding="15,10" Margin="0,0,0,15">
            <Grid ColumnDefinitions="Auto,*,Auto,Auto">

                <Button Grid.Column="0"
                        Command="{Binding AskAICommand}"
                        IsEnabled="{Binding !IsLoading}"
                        Classes="Primary"
                        CornerRadius="15"
                        Padding="15,8"
                        Margin="0,0,10,0">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <material:MaterialIcon Kind="Camera" Width="18" Height="18" Foreground="White"/>
                        <TextBlock Text="Ask AI" VerticalAlignment="Center" FontWeight="Bold" Foreground="White" />
                    </StackPanel>
                </Button>

                <TextBox Grid.Column="1"
                         Text="{Binding UserInput}"
                         Watermark="Ask me anything... (Press Enter to send)"
                         VerticalAlignment="Center"
                         BorderThickness="0"
                         Background="Transparent"
                         Foreground="White"
                         FontSize="15"
                         Classes="Clear"
                         CaretBrush="White">
                    <TextBox.KeyBindings>
                        <KeyBinding Gesture="Enter" Command="{Binding SendTextCommand}" />
                    </TextBox.KeyBindings>
                </TextBox>

                <suki:Loading Grid.Column="2"
                              IsVisible="{Binding IsLoading}"
                              Width="25" Height="25"
                              Margin="10,0" />

                <Button Grid.Column="3"
                        Command="{Binding ToggleResponseCommand}"
                        IsVisible="{Binding IsResponseVisible}"
                        Classes="Basic Rounded"
                        ToolTip.Tip="Hide response window"
                        Margin="5,0,0,0">
                    <material:MaterialIcon Kind="Close" Width="20" Height="20" Foreground="#A0FFFFFF" />
                </Button>
            </Grid>
        </Border>

        <!-- Response Area -->
        <Border Grid.Row="1" CornerRadius="20" Background="#DD151515" BorderBrush="#30FFFFFF" BorderThickness="1" BoxShadow="0 10 30 0 #60000000" Padding="0"
                IsVisible="{Binding IsResponseVisible}">

            <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding ConversationHistory}" Padding="25,25,25,40">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,0,0,30">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Width="36" Height="36" CornerRadius="18"
                                        VerticalAlignment="Top" Margin="0,0,15,0"
                                        Background="{DynamicResource SukiPrimaryColor}">
                                    <TextBlock Text="{Binding Role}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                               FontSize="10" FontWeight="Bold"
                                               Foreground="White" />
                                </Border>

                                <StackPanel Grid.Column="1" Spacing="8">
                                    <TextBlock Text="{Binding Role}" FontWeight="SemiBold" FontSize="13" Foreground="#B0FFFFFF"/>

                                    <!-- Markdown Output -->
                                    <mark:MarkdownRenderer MarkdownBuilder="{Binding MarkdownBuilder}"
                                                           TextElement.Foreground="White"
                                                           CodeBlockColorTheme="DarkPlus"
                                                           HorizontalAlignment="Stretch">
                                        <mark:MarkdownRenderer.Styles>
                                            <Style Selector="mark|CodeBlock">
                                                <Setter Property="FontFamily" Value="ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace" />
                                                <Setter Property="Foreground" Value="White" />
                                                <Setter Property="Background" Value="#1A1A1A" />
                                            </Style>
                                            <Style Selector="TextBlock.CodeBlock">
                                                <Setter Property="FontFamily" Value="ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace" />
                                                <Setter Property="Foreground" Value="White" />
                                            </Style>
                                            <Style Selector="SelectableTextBlock.CodeBlock">
                                                <Setter Property="FontFamily" Value="ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace" />
                                                <Setter Property="Foreground" Value="White" />
                                            </Style>
                                            <Style Selector="Border.CodeBlock">
                                                <Setter Property="Background" Value="#1A1A1A" />
                                            </Style>
                                            <!-- Standard Markdown class names often used -->
                                            <Style Selector="TextBlock.code">
                                                <Setter Property="FontFamily" Value="ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace" />
                                            </Style>
                                            <Style Selector="SelectableTextBlock.code">
                                                <Setter Property="FontFamily" Value="ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace" />
                                            </Style>
                                        </mark:MarkdownRenderer.Styles>
                                    </mark:MarkdownRenderer>

                                    <Border IsVisible="{Binding LocalImagePath, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                            CornerRadius="12" Background="#20FFFFFF" BorderBrush="#40FFFFFF" BorderThickness="1"
                                            Padding="5" Margin="0,10,0,0" HorizontalAlignment="Left"
                                            MaxWidth="400" MaxHeight="300">
                                        <Image Source="{Binding LocalImagePath, Converter={StaticResource LocalPathToBitmapConverter}}"
                                               Stretch="Uniform"
                                               HorizontalAlignment="Left"
                                               ClipToBounds="True"/>
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

    </Grid>
</Window>
